# Скопируйте в .env и заполните.

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Прокси для Telegram (необязательно): http://user:pass@host:3128 или socks5://host:1080
TELEGRAM_PROXY_URL=
# Чат (группа) для алертов, у ботов id вида -100xxxxxxxxxx
TG_CHAT_ID=-1001234567890
# Топик для "все камеры" (0 = без топика)
TG_TOPIC_ALL=0

# Frigate
FRIGATE_URL=http://frigate:5000
# FRIGATE_USER=
# FRIGATE_PASSWORD=
# FRIGATE_TOKEN=

# MQTT-брокер
MQTT_HOST=mqtt
# MQTT_USER=
# MQTT_PASSWORD=

LOG_LEVEL=INFO
