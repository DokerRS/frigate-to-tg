# Пример конфигурации frigate-to-tg.
# Скопируйте в .env — этот файл не попадает в git (см. .gitignore),
# поэтому секреты можно писать прямо сюда. docker compose подхватывает .env
# автоматически (файл рядом с docker-compose.yml).

# --- Telegram (обязательно) ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# HTTP/SOCKS прокси для доступа к api.telegram.org, например:
#   http://user:pass@proxy.local:3128  или  socks5://proxy.local:1080
TELEGRAM_PROXY_URL=

# --- Frigate ---
FRIGATE_URL=http://192.168.1.10:5000
# внешний адрес Frigate (тот, что открывается в браузере с телефона),
# используется для кнопки «🔗 Открыть в Frigate». По умолчанию = FRIGATE_URL.
#FRIGATE_PUBLIC_URL=http://192.168.1.10:5000
# авторизация (если Frigate закрыт логином): basic auth или токен
#FRIGATE_USER=admin
#FRIGATE_PASSWORD=secret
#FRIGATE_TOKEN=<frigate api token>
FRIGATE_POLL_INTERVAL=3     # как часто (сек) опрашивать Frigate API на новые события
FRIGATE_LOOKBACK=60         # за сколько секунд назад смотреть события при опросе
#FRIGATE_SNAPSHOT_QUALITY=80   # качество JPEG снапшота из Frigate (1..100); с PHOTO_AS_DOCUMENT=true ставь 95

# --- Логи ---
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR (можно менять на лету командой /debug в чате)
#LOG_FILE=/data/frigate-to-tg.log   # дополнительный лог в файл (по умолчанию только stdout)
#LOG_HTTP_DEBUG=false       # true = отладочные логи HTTP-запросов (httpx/httpcore)

# --- Поведение алертов ---
#CAPTION_CARD=true          # компактная подпись в две строки: "🚗 Car — камера · зоны" / "80% · 🕒 время"
#TIMEZONE=Asia/Almaty       # таймзона для времени в карточке (пусто = время сервера)
#PHOTO_AS_DOCUMENT=false     # true = кадр уходит файлом (исходное разрешение и качество).
#                            # Telegram в sendPhoto всегда пережимает фото до 2048 px и заново жмёт JPEG.
#                            # Минус: кадр показывается как файл, а не как большое фото в ленте.
#SEND_VIDEO_BUTTON=true     # кнопка "Видео" под фото (по запросу)
#VIDEO_MAX_MB=45            # лимит для Telegram (боты могут до ~50 МБ)
#ALERT_MIN_SCORE=0.7        # общий минимальный score (по маршруту — ROUTE_N_MIN_SCORE)
#ONE_ALERT_PER_EVENT=true   # одно событие = одно сообщение
#REQUIRE_SNAPSHOT=true
#CAPTION_FORMAT={camera}: {label} — {score}%   # используется при CAPTION_CARD=false

# --- Группы камер ---
GROUPS_FROM_FRIGATE=true    # читать camera_groups из конфига Frigate
# дополнительные группы, которых нет в Frigate (через запятую):
#GROUP_FRONT=front_door_cam,porch_cam

# --- Маршруты: чат + топик <- группы/камеры ---
# chat_id группы Telegram берите со знаком минус (у ботов он вида -100xxxxxxxxxx),
# узнайте через /chatid в чате. THREAD_ID — id топика (0 => без топика).
# Нумерация произвольная: ROUTE_1_..., ROUTE_2_...

ROUTE_1_CHAT_ID=-1001234567890
ROUTE_1_THREAD_ID=0
ROUTE_1_TITLE=Все камеры
#ROUTE_1_GROUPS=            # пусто + пусто ROUTE_1_CAMERAS = все камеры
#ROUTE_1_OBJECTS=person,car
#ROUTE_1_MIN_SCORE=0.7

# Пример: все камеры из frigate-группы "front" -> топик "Передняя дверь"
#ROUTE_2_CHAT_ID=-1001234567890
#ROUTE_2_THREAD_ID=42
#ROUTE_2_TITLE=Передняя дверь
#ROUTE_2_GROUPS=front

# Пример: конкретные камеры -> отдельный чат
#ROUTE_3_CHAT_ID=-1001234567890
#ROUTE_3_CAMERAS=driveway_cam
#ROUTE_3_SEND_VIDEO=true
