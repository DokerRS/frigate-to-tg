# Скопируйте в .env и заполните. Здесь только секреты.
# Все остальные настройки (адреса Frigate/MQTT, чаты, топики, группы) — в config/config.yaml.

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Прокси для Telegram (необязательно): http://user:pass@host:3128 или socks5://host:1080
TELEGRAM_PROXY_URL=

# Необязательно: авторизация (можно также указать прямо в config/config.yaml)
# FRIGATE_USER=
# FRIGATE_PASSWORD=
# FRIGATE_TOKEN=
# MQTT_USER=
# MQTT_PASSWORD=

LOG_LEVEL=INFO
